---
import { Image } from "astro:assets";
import { siteConfig, getCtaHref } from "../site.config";
import heroRobot from "../assets/hero-robot.jpg";

const ctaHref = getCtaHref();
---

<section id="top" class="relative overflow-hidden px-6 pt-20 pb-24 md:pt-28 md:pb-32">
  <div class="mx-auto grid max-w-6xl items-center gap-14 md:grid-cols-2">
    <div class="reveal">
      <p class="text-sm font-semibold tracking-[0.2em] text-accent">
        {siteConfig.hero.eyebrow}
      </p>
      <h1
        class="mt-5 text-4xl font-extrabold leading-[1.08] tracking-tight text-heading md:text-5xl lg:text-6xl"
      >
        {siteConfig.hero.headline}
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-body md:text-xl">
        {siteConfig.hero.subline}
      </p>
      <p class="mt-3 max-w-xl text-lg font-bold text-heading md:text-xl">
        {siteConfig.hero.clarifier}
      </p>
      <div class="mt-9">
        <a
          href={ctaHref}
          class="inline-flex items-center rounded-md bg-accent px-6 py-3.5 text-base font-semibold text-background transition-colors hover:bg-accent-hover"
        >
          {siteConfig.hero.ctaLabel}
        </a>
      </div>
    </div>

    <!-- Hero visual: src/assets/hero-robot.jpg, served through astro:assets so it's
         auto-resized/compressed at build time instead of shipping the multi-MB original. -->
    <div class="reveal relative">
      <div
        class="absolute -inset-4 rounded-[2rem] bg-accent/20 blur-2xl"
        aria-hidden="true"
      >
      </div>
      <div
        class="relative overflow-hidden rounded-2xl border border-accent/40 bg-panel/60 shadow-[0_0_80px_-20px_rgba(245,166,35,0.45)]"
      >
        <Image
          src={heroRobot}
          alt={siteConfig.hero.imageAlt}
          width={1200}
          widths={[400, 800, 1200]}
          sizes="(min-width: 768px) 50vw, 100vw"
          class="aspect-[3/2] h-full w-full object-cover"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>
