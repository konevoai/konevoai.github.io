---
import { siteConfig } from "../site.config";
---

<section class="px-6 py-24">
  <div
    class="reveal mx-auto max-w-4xl rounded-2xl border border-panel-border bg-panel px-8 py-14 text-center"
  >
    <h2 class="text-2xl font-extrabold tracking-tight text-heading md:text-3xl">
      {siteConfig.whereWeStart.heading}
    </h2>
    <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-body">
      {siteConfig.whereWeStart.body}
    </p>
  </div>
</section>
