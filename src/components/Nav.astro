---
import { Image } from "astro:assets";
import { siteConfig, getCtaHref } from "../site.config";
import Icon from "../icons/Icon.astro";
import konevoWhite from "../assets/konevo_white.png";

const ctaHref = getCtaHref();
---

<header
  class="sticky top-0 z-40 border-b border-panel-border/70 bg-background/90 backdrop-blur"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4"
    aria-label="Primary"
  >
    <a href="#top" class="shrink-0">
      <Image
        src={konevoWhite}
        alt="Konevo"
        width={534}
        height={90}
        class="h-[30px] w-auto"
        loading="eager"
      />
    </a>

    <!-- Desktop links -->
    <ul class="hidden items-center gap-8 md:flex">
      {
        siteConfig.nav.links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm font-medium text-body transition-colors hover:text-heading"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="hidden md:block">
      <a
        href={ctaHref}
        class="inline-flex items-center rounded-md bg-accent px-4 py-2 text-sm font-semibold text-background transition-colors hover:bg-accent-hover"
      >
        {siteConfig.nav.ctaLabel}
      </a>
    </div>

    <!-- Mobile menu toggle -->
    <button
      id="nav-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-md p-2 text-heading md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle navigation menu"
    >
      <Icon name="menu" class="h-6 w-6" />
    </button>
  </nav>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" class="hidden border-t border-panel-border/70 md:hidden">
    <ul class="flex flex-col gap-1 px-6 py-4">
      {
        siteConfig.nav.links.map((link) => (
          <li>
            <a
              href={link.href}
              class="block rounded-md px-2 py-2 text-base font-medium text-body hover:bg-panel hover:text-heading"
            >
              {link.label}
            </a>
          </li>
        ))
      }
      <li class="pt-2">
        <a
          href={ctaHref}
          class="block rounded-md bg-accent px-4 py-2 text-center text-base font-semibold text-background hover:bg-accent-hover"
        >
          {siteConfig.nav.ctaLabel}
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(isOpen));
  });

  // Close the mobile menu after tapping a link.
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
