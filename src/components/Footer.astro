---
import { siteConfig, getMailtoHref } from "../site.config";
import Icon from "../icons/Icon.astro";

const currentYear = new Date().getFullYear();
const mailHref = getMailtoHref();
---

<footer class="border-t border-panel-border px-6 py-12">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-4 text-center">
    <p class="text-lg font-extrabold tracking-tight text-heading">
      {siteConfig.companyName}
    </p>
    <p class="text-sm text-body/70">{siteConfig.footer.tagline}</p>

    <div class="flex items-center gap-6">
      <a
        href={mailHref}
        class="inline-flex items-center gap-2 text-sm text-body transition-colors hover:text-accent"
      >
        <Icon name="mail" class="h-4 w-4" />
        {siteConfig.contact.email}
      </a>
      <a
        href={siteConfig.contact.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm text-body transition-colors hover:text-accent"
      >
        <Icon name="linkedin" class="h-4 w-4" />
        LinkedIn
      </a>
    </div>

    <p class="text-xs text-body/60">
      &copy; {currentYear} {siteConfig.companyName}. All rights reserved.
    </p>
    <p class="text-xs text-body/40">{siteConfig.nameMeaning}</p>
  </div>
</footer>
