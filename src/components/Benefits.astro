---
// Slim supporting strip below the capability cards in WhatWeDo.astro —
// deliberately smaller and quieter than the capability cards so it reads
// as supporting evidence, not a competing set of features.
import { siteConfig } from "../site.config";
import Icon from "../icons/Icon.astro";
---

<section class="px-6 pt-4 pb-24">
  <div class="mx-auto max-w-5xl">
    <p
      class="reveal text-center text-xs font-semibold tracking-[0.2em] text-body/60"
    >
      {siteConfig.benefits.heading.toUpperCase()}
    </p>

    <div
      class="reveal mt-6 flex flex-col divide-y divide-panel-border rounded-2xl border border-panel-border bg-panel/40 sm:flex-row sm:divide-x sm:divide-y-0"
    >
      {
        siteConfig.benefits.items.map((item) => (
          <div class="flex flex-1 items-center gap-3 px-6 py-4">
            <span class="text-accent" aria-hidden="true">
              <Icon name={item.icon as any} class="h-5 w-5" />
            </span>
            <span class="text-sm">
              <span class="font-bold text-heading">{item.label}</span>
              <span class="text-body/70"> — {item.caption}</span>
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
