---
import { siteConfig } from "../site.config";
---

<section id="vision" class="px-6 py-24">
  <div
    class="reveal mx-auto max-w-3xl rounded-2xl border border-panel-border bg-panel p-8 text-center md:p-12"
  >
    <h2 class="text-3xl font-extrabold tracking-tight text-heading md:text-4xl">
      {siteConfig.vision.heading}
    </h2>
    <p class="mt-6 text-lg leading-relaxed text-body md:text-xl">
      {siteConfig.vision.body}
    </p>
  </div>
</section>
