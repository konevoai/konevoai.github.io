---
// Light credibility signal near the bottom of the page — a location line
// so the page reads as grounded rather than purely aspirational even pre-launch.
// A partner/press logo row can be added back here once real logos exist.
import { siteConfig } from "../site.config";
---

<section class="px-6 pb-24">
  <div class="reveal mx-auto max-w-4xl text-center">
    <p class="text-sm font-medium text-body/70">{siteConfig.credibility.line}</p>
  </div>
</section>
